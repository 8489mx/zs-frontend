# Same origin: nginx serves /api next to the app on app.zsystemai.com (and on every store host).
# A host name here would send the browser cross-origin for no reason. The deploy workflow passes
# the GitHub variable VITE_API_BASE_URL, which is empty for the same reason.
VITE_API_BASE_URL=
VITE_CSRF_COOKIE_NAME=zs_cloud_csrf_token